doctype html
html
  head
    block head
      meta(charset='UTF-8')
      meta(name='viewport' content='width=device-width, initial-scale=1.0')

      link(rel='stylesheet' href='/css/style.css')
      link(
        rel='shortcut icon'
        type='image/png'
        href='/img/favicon.png'
      )

      title Travel Planner | #{title}

      script(src='https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.js')
      link(
        href='https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.css'
        rel='stylesheet'
      )

  body

    // HEADER
    header.header
      nav.nav.nav--tours
        a.nav__el(href='/') All tours

      .header__logo
        img(
          src='/img/logo-white.png'
          alt='Travel Planner logo'
        )

      nav.nav.nav--user
        if user
          a.nav__el.nav__el--logout(href="#") Log out

          a.nav__el(href='/me')
            img.nav__user-img(
              src=`/img/users/${user.photo}`
              alt=`Photo of ${user.name}`
            )
            span= user.name.split(' ')[0]

        else
          a.nav__el(href='/login') Log in
          a.nav__el.nav__el--cta(href='/signup') Sign up

    // CONTENT
    block content
      h1 This is a placeholder heading

    // FOOTER
    footer.footer
      p.footer__copyright
        | &copy; by the Travel Planner application project.

    // MAIN JAVASCRIPT
    script(src="/dist/js/index.js")