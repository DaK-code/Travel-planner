extends base

mixin navItem(link, text, icon, active)
  li(class=`${active ? 'side-nav--active' : ''}`)
    a(href=`${link}`)
      svg
        use(xlink:href=`/img/icons.svg#icon-${icon}`)
      | #{text}

block content
  main.main
    .user-view
      //- SIDE NAVIGATION
      nav.user-view__menu
        ul.side-nav
          +navItem('/me', 'Settings', 'settings', true)
          +navItem('/my-tours', 'My bookings', 'briefcase', false)
          +navItem('/my-reviews', 'My reviews', 'star', false)

        - if (user.role === 'admin' || user.role === 'lead-guide')
          .admin-nav
            h5.admin-nav__heading Admin

            ul.side-nav
              +navItem('/manage-tours', 'Manage tours', 'map', false)
              +navItem('/manage-users', 'Manage users', 'users', false)
              +navItem('/manage-reviews', 'Manage reviews', 'star', false)
              +navItem('/manage-bookings', 'Manage bookings', 'briefcase', false)

      //- MAIN CONTENT
      .user-view__content
        //- SECTION 1: USER ACCOUNT SETTINGS
        .user-view__form-container
          h2.heading-secondary.ma-bt-md Your account settings
          
          form.form.form-user-data(action='/submit-user-data' method='POST' enctype='multipart/form-data')
            .form__group
              label.form__label(for='name') Full Name
              input#name.form__input(
                type='text'
                name='name'
                value=`${user.name}`
                required
                autocomplete='name'
              )

            .form__group.ma-bt-md
              label.form__label(for='email') Email address
              input#email.form__input(
                type='email'
                name='email'
                value=`${user.email}`
                required
                autocomplete='email'
              )

            .form__group.form-photo-upload
              img.form__user-photo(
                src=`/img/users/${user.photo || 'default.jpg'}` 
                alt=`Photo of ${user.name}`
              )
              input#photo.form__upload(
                type='file'
                accept='image/*'
                name='photo'
              )
              label(for='photo') Choose new photo

            .form__group.right
              button.btn.btn--small.btn--green(type='submit') Save settings

        .line &nbsp;

        // SECURITY (PASSWORD CHANGE)
        .user-view__form-container
          h2.heading-secondary.ma-bt-md Password change
          
          form.form.form-user-password
            .form__group
              label.form__label(for='password-current') Current password
              input#password-current.form__input(
                type='password'
                placeholder='••••••••'
                required
                minlength='8'
                autocomplete='current-password'
              )

            .form__group
              label.form__label(for='password') New password
              input#password.form__input(
                type='password'
                placeholder='••••••••'
                required
                minlength='8'
                autocomplete='new-password'
              )

            .form__group.ma-bt-lg
              label.form__label(for='password-confirm') Confirm password
              input#password-confirm.form__input(
                type='password'
                placeholder='••••••••'
                required
                minlength='8'
                autocomplete='new-password'
              )

            .form__group.right
              button.btn.btn--small.btn--green.btn--save-password(type='submit') Save password