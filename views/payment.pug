extends base

block content
  section.section-header
    .header__hero
      .header__hero-overlay

      img.header__hero-img(
        src=`/img/tours/${tour.imageCover}`
        alt=tour.name
      )

    .heading-box
      h1.heading-primary
        span Payment

  section.section-description
    .overview-box
      h2.heading-secondary.ma-bt-lg Confirm your booking

      .overview-box__detail
        span.overview-box__label Tour:
        span.overview-box__text= tour.name

      .overview-box__detail
        span.overview-box__label Duration:
        span.overview-box__text #{tour.duration} days

      .overview-box__detail
        span.overview-box__label Price:
        span.overview-box__text $#{tour.price}

    .description-box
      h2.heading-secondary Secure Payment

      p.description__text
        | You will be redirected to Stripe Checkout to complete your payment.
        | This is a test payment. No real money will be charged.

      form#stripe-payment-form
        //- Only the tour ID is sent to the backend.
        //- The price is NEVER trusted from the frontend.
        input#tour-id(
          type="hidden"
          value=tour._id
        )

        button.btn.btn--green#pay-button(
          type="submit"
        ) Pay $#{tour.price}

        p#payment-message

